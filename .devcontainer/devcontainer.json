{
  "name": "PM Workstation",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "esbenp.prettier-vscode",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "postCreateCommand": "pip install -e .[dev] && cd frontend && npm install",
  "forwardPorts": [
    3000,
    8000
  ],
  "remoteUser": "root"
}
