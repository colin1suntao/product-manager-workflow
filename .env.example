# 应用配置
# 复制此文件为 .env 并填入实际值

# LLM模型配置
DEFAULT_MODEL=openai
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# 数据库配置
DATABASE_URL=sqlite:///./pm_workstation.db
REDIS_URL=redis://localhost:6379/0

# 存储配置
STORAGE_TYPE=local
STORAGE_PATH=./data/deliverables

# 外部系统集成（可选）
JIRA_BASE_URL=
JIRA_API_TOKEN=
FIGMA_ACCESS_TOKEN=
GITHUB_TOKEN=
GITLAB_TOKEN=
